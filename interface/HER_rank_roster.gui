guiTypes = {

	# Launcher attached to the vanilla Officer Corps view.
	containerWindowType = {
		name = "HER_rank_roster_launcher"
		position = { x = 382 y = 292 }
		size = { width = 150 height = 30 }
		clipping = no

		buttonType = {
			name = "open_rank_roster"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_button_148x34"
			buttonText = "HER_RANK_ROSTER_OPEN"
			buttonFont = "hoi_16mbs"
			pdx_tooltip = "HER_RANK_ROSTER_OPEN_TT"
			clicksound = click_default
		}
	}

	# HER rank-management roster. It is populated by scripted GUI with
	# unit-leader scopes, so buttons inside each row operate on that leader.
	containerWindowType = {
		name = "HER_rank_roster_window"
		position = { x = 8 y = 172 }
		size = { width = 534 height = 520 }
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window2_1b_border"
		}

		instantTextboxType = {
			name = "title"
			position = { x = 18 y = 12 }
			font = "hoi_24header"
			text = "HER_RANK_ROSTER_TITLE"
			maxWidth = 440
			maxHeight = 28
			fixedsize = yes
			format = left
		}

		buttonType = {
			name = "close_rank_roster"
			position = { x = -38 y = 8 }
			quadTextureSprite = "GFX_closebutton"
			buttonFont = "Main_14_black"
			Orientation = "UPPER_RIGHT"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		instantTextboxType = {
			name = "description"
			position = { x = 18 y = 43 }
			font = "hoi_16mbs"
			text = "HER_RANK_ROSTER_DESC"
			maxWidth = 490
			maxHeight = 34
			fixedsize = yes
			format = left
		}

		containerWindowType = {
			name = "rank_roster_scroll"
			position = { x = 14 y = 79 }
			size = { width = 505 height = 424 }
			verticalScrollbar = "right_vertical_slider"
			margin = { top = 4 bottom = 6 right = 16 }
			scroll_wheel_factor = 42
			smooth_scrolling = yes

			gridBoxType = {
				name = "rank_roster_grid"
				position = { x = 0 y = 0 }
				size = { width = 485 height = 100%% }
				slotsize = { width = 485 height = 42 }
				max_slots_horizontal = 1
				format = "UPPER_LEFT"
			}
		}
	}

	containerWindowType = {
		name = "HER_rank_roster_entry"
		size = { width = 485 height = 42 }
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_transparent"
		}

		instantTextboxType = {
			name = "leader_name"
			position = { x = 12 y = 11 }
			font = "hoi_18mbs"
			text = "HER_RANK_ROSTER_LEADER_NAME"
			maxWidth = 330
			maxHeight = 22
			fixedsize = yes
			format = left
		}

		buttonType = {
			name = "her_rank_demote"
			position = { x = 375 y = 7 }
			quadTextureSprite = "GFX_leader_selection_button"
			buttonText = "HER_UNIT_LEADER_DEMOTE"
			buttonFont = "hoi_16mbs"
			pdx_tooltip = "HER_UNIT_LEADER_DEMOTE_TT"
			clicksound = click_default
			frame = 1
		}
	}
}
